	<string>Musify needs access to your photo library to set custom playlist artwork.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Musify needs access to documents to store and export playlists and offline audio.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
