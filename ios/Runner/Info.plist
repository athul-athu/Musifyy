	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.gokadzev.musify</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>musify</string>
				<string>ShareMedia</string>
			</array>
		</dict>
	</array>
